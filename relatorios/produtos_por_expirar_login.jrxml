<?xml version="1.0" encoding="UTF-8"?>
<!--
  RELATÓRIO DE PRODUTOS POR EXPIRAR  (ecrã de login - lotes de um armazém)
  Fonte de dados: o modelo da tabela do painel do LoginVisao (JRTableModelDataSource),
  por isso imprime EXACTAMENTE as linhas que a tabela mostra.

  Campos (nome = COLUMN_ + índice):
    COLUMN_0 Código | COLUMN_1 Designação Produto | COLUMN_2 Lote | COLUMN_3 Data Validade
    COLUMN_4 Dias restantes (não é impresso: só serve para colorir a linha)

  Parâmetros enviados pelo programa: FILTROS, DATA_EMISSAO, DIAS_ALERTA

  Abrir no iReport para ajustar o desenho e compilar (gera produtos_por_expirar_login.jasper).
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="produtos_por_expirar_login" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<style name="linha" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{COLUMN_4} != null && $F{COLUMN_4}.intValue() < 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#FFAAAA"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{COLUMN_4} != null && $F{COLUMN_4}.intValue() >= 0 && $F{COLUMN_4}.intValue() <= $P{DIAS_ALERTA}.intValue()]]></conditionExpression>
			<style mode="Opaque" backcolor="#FFCC99"/>
		</conditionalStyle>
	</style>
	<parameter name="FILTROS" class="java.lang.String"/>
	<parameter name="DATA_EMISSAO" class="java.lang.String"/>
	<parameter name="DIAS_ALERTA" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[Integer.valueOf(30)]]></defaultValueExpression>
	</parameter>
	<field name="COLUMN_0" class="java.lang.Integer"/>
	<field name="COLUMN_1" class="java.lang.String"/>
	<field name="COLUMN_2" class="java.lang.String"/>
	<field name="COLUMN_3" class="java.lang.String"/>
	<field name="COLUMN_4" class="java.lang.Integer"/>
	<title>
		<band height="64">
			<staticText>
				<reportElement x="0" y="0" width="555" height="28"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="16" isBold="true"/>
				</textElement>
				<text><![CDATA[RELATÓRIO DE PRODUTOS POR EXPIRAR]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="0" y="30" width="555" height="16"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$P{FILTROS}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="47" width="555" height="14"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8" isItalic="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Emitido em: " + $P{DATA_EMISSAO}]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<columnHeader>
		<band height="22">
			<staticText>
				<reportElement mode="Opaque" x="0" y="0" width="60" height="22" backcolor="#DDDDDD"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
					<topPen lineWidth="0.5" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Código]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="60" y="0" width="275" height="22" backcolor="#DDDDDD"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
					<topPen lineWidth="0.5" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[ Designação Produto]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="335" y="0" width="110" height="22" backcolor="#DDDDDD"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
					<topPen lineWidth="0.5" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[ Lote]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="445" y="0" width="110" height="22" backcolor="#DDDDDD"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
					<topPen lineWidth="0.5" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Data Validade]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="18">
			<textField isBlankWhenNull="true">
				<reportElement style="linha" stretchType="RelativeToTallestObject" x="0" y="0" width="60" height="18"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
					<topPen lineWidth="0.5" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.Integer"><![CDATA[$F{COLUMN_0}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement style="linha" stretchType="RelativeToTallestObject" x="60" y="0" width="275" height="18"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
					<topPen lineWidth="0.5" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[" " + $F{COLUMN_1}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement style="linha" stretchType="RelativeToTallestObject" x="335" y="0" width="110" height="18"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
					<topPen lineWidth="0.5" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[" " + $F{COLUMN_2}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="linha" stretchType="RelativeToTallestObject" x="445" y="0" width="110" height="18"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
					<topPen lineWidth="0.5" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{COLUMN_3}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band height="20">
			<textField>
				<reportElement x="405" y="3" width="100" height="14"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement x="505" y="3" width="50" height="14"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
	<summary>
		<band height="26">
			<textField>
				<reportElement x="0" y="6" width="400" height="16"/>
