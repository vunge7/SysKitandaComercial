	<field name="forma_pagamento_item_pk_forma_pagamento_item" class="java.lang.Integer"/>
	<field name="forma_pagamento_item_valor" class="java.math.BigDecimal"/>
	<field name="forma_pagamento_item_referencia" class="java.lang.String"/>
