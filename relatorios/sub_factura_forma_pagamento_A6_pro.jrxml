	<style name="base" isDefault="true" fontName="Arial" fontSize="7"/>
	<parameter name="CODIGO_VENDA" class="java.lang.Integer"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["../relatorios/"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT
     forma_pagamento.`designacao` AS forma_pagamento_designacao,
     forma_pagamento_item.`pk_forma_pagamento_item` AS forma_pagamento_item_pk_forma_pagamento_item,
     forma_pagamento_item.`valor` AS forma_pagamento_item_valor,
     forma_pagamento_item.`referencia` AS forma_pagamento_item_referencia
FROM
     `forma_pagamento` forma_pagamento INNER JOIN `forma_pagamento_item` forma_pagamento_item ON forma_pagamento.`pk_forma_pagamento` = forma_pagamento_item.`fk_forma_pagamento`
WHERE forma_pagamento_item.`fk_venda` = $P{CODIGO_VENDA}]]>
	</queryString>
