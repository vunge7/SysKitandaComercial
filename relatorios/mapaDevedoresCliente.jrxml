<property name="ireport.encoding" value="UTF-8"/>
<style name="Estado" forecolor="#15803D"><conditionalStyle><conditionExpression><![CDATA[$F{estado} != null && ($F{estado}.startsWith("Em atraso") || $F{estado}.startsWith("Vence"))]]></conditionExpression><style forecolor="#B91C1C"/></conditionalStyle><conditionalStyle><conditionExpression><![CDATA[$F{estado} != null && $F{estado}.startsWith("A vencer")]]></conditionExpression><style forecolor="#B45309"/></conditionalStyle></style><parameter name="EMPRESA" class="java.lang.String"/>
