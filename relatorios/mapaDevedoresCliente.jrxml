<variable name="C_MENS" class="java.math.BigDecimal" resetType="Group" resetGroup="cliente" calculation="Sum"><variableExpression><![CDATA[$F{mensalidade}]]></variableExpression></variable>
<variable name="C_MULTA" class="java.math.BigDecimal" resetType="Group" resetGroup="cliente" calculation="Sum"><variableExpression><![CDATA[$F{multa}]]></variableExpression></variable>
<variable name="C_TOTAL" class="java.math.BigDecimal" resetType="Group" resetGroup="cliente" calculation="Sum"><variableExpression><![CDATA[$F{total}]]></variableExpression></variable>
<variable name="C_MESES" class="java.lang.Integer" resetType="Group" resetGroup="cliente" calculation="Sum"><variableExpression><![CDATA[$F{mes} != null && !$F{mes}.isEmpty() && $F{dias} != null && $F{dias}.intValue() > 0 ? 1 : 0]]></variableExpression></variable>
