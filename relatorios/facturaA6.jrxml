   : "   |   " + ($F{tb_dados_instituicao_telefone}.trim().toUpperCase().startsWith("TEL") ? $F{tb_dados_instituicao_telefone}.trim() : "Tel.: " + $F{tb_dados_instituicao_telefone}.trim()))]]></textFieldExpression>
