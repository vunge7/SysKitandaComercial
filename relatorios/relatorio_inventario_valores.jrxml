		<band height="26">
			<rectangle>
				<reportElement x="0" y="0" width="802" height="26" backcolor="#404040"/>
				<graphicElement><pen lineWidth="0.0"/></graphicElement>
			</rectangle>
			<staticText><reportElement x="1" y="0" width="38" height="26" forecolor="#FFFFFF"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Código]]></text></staticText>
			<staticText><reportElement x="41" y="0" width="148" height="26" forecolor="#FFFFFF"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Produto]]></text></staticText>
