<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="relatorio_inventario_valores" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">

	<!-- 0 = todos os armazéns -->
	<parameter name="ARMAZEM_ID" class="java.lang.Integer"/>
	<parameter name="ARMAZEM_NOME" class="java.lang.String"/>
	<!-- 0 = todos os produtos -->
	<parameter name="PRODUTO_ID" class="java.lang.Integer"/>
	<parameter name="PRODUTO_NOME" class="java.lang.String"/>
	<!-- TODAS | VENCIDO | A_VENCER | OK | SEM_LOTE | DIVERGENTE -->
	<parameter name="SITUACAO" class="java.lang.String"/>
	<parameter name="SITUACAO_NOME" class="java.lang.String"/>
	<!-- dias para considerar um lote "a vencer" -->
	<parameter name="DIAS_ALERTA" class="java.lang.Integer"/>
	<!-- 1 = incluir linhas com stock zero -->
	<parameter name="INCLUIR_ZERO" class="java.lang.Integer"/>

	<queryString>
		<![CDATA[
SELECT x.* FROM (

    /* A) STOCK POR LOTE (validade, dias para caducar e situacao) */
    SELECT
        a.codigo AS armazem_id,
        a.designacao AS armazem,
        p.codigo AS produto_id,
        p.designacao AS produto,
        l.numero_lote AS numero_lote,
        DATE_FORMAT(l.data_validade, '%d/%m/%Y') AS validade_txt,
        l.data_validade AS validade_ord,
        DATEDIFF(l.data_validade, CURDATE()) AS dias,
        CASE WHEN l.data_validade IS NULL THEN 'SEM_VALIDADE' WHEN l.data_validade < CURDATE() THEN 'VENCIDO' WHEN DATEDIFF(l.data_validade, CURDATE()) <= $P{DIAS_ALERTA} THEN 'A_VENCER' ELSE 'OK' END AS situacao,
        CAST(l.qtd AS DECIMAL(18,3)) AS qtd_sistema,
        CAST(COALESCE((SELECT pr.preco_venda FROM tb_preco pr WHERE pr.fk_produto = p.codigo ORDER BY pr.qtd_baixo ASC, pr.pk_preco DESC LIMIT 1), 0) AS DECIMAL(18,2)) AS preco,
        CAST(l.qtd * COALESCE((SELECT pr.preco_venda FROM tb_preco pr WHERE pr.fk_produto = p.codigo ORDER BY pr.qtd_baixo ASC, pr.pk_preco DESC LIMIT 1), 0) AS DECIMAL(18,2)) AS valor
    FROM lote l
    INNER JOIN tb_produto p ON p.codigo = l.fk_produto
    INNER JOIN tb_armazem a ON a.codigo = l.fk_armazem
    WHERE ($P{ARMAZEM_ID} = 0 OR l.fk_armazem = $P{ARMAZEM_ID})
      AND ($P{PRODUTO_ID} = 0 OR l.fk_produto = $P{PRODUTO_ID})

    UNION ALL

    /* B) STOCK SEM LOTE: produtos sem lotes, ou parte do stock que os lotes nao cobrem
          (se os lotes somarem mais do que o stock, fica DIVERGENTE) */
    SELECT
        a3.codigo AS armazem_id,
        a3.designacao AS armazem,
        p3.codigo AS produto_id,
        p3.designacao AS produto,
        '-' AS numero_lote,
        '-' AS validade_txt,
        NULL AS validade_ord,
        NULL AS dias,
        CASE WHEN (s.quantidade_existente - COALESCE(ls.soma, 0)) < 0 THEN 'DIVERGENTE' ELSE 'SEM_LOTE' END AS situacao,
        CAST((s.quantidade_existente - COALESCE(ls.soma, 0)) AS DECIMAL(18,3)) AS qtd_sistema,
        CAST(COALESCE((SELECT pr.preco_venda FROM tb_preco pr WHERE pr.fk_produto = p3.codigo ORDER BY pr.qtd_baixo ASC, pr.pk_preco DESC LIMIT 1), 0) AS DECIMAL(18,2)) AS preco,
        CAST((s.quantidade_existente - COALESCE(ls.soma, 0)) * COALESCE((SELECT pr.preco_venda FROM tb_preco pr WHERE pr.fk_produto = p3.codigo ORDER BY pr.qtd_baixo ASC, pr.pk_preco DESC LIMIT 1), 0) AS DECIMAL(18,2)) AS valor
    FROM tb_stock s
    INNER JOIN tb_produto p3 ON p3.codigo = s.cod_produto_codigo
    INNER JOIN tb_armazem a3 ON a3.codigo = s.cod_armazem
    LEFT JOIN (SELECT fk_produto, fk_armazem, SUM(qtd) AS soma, COUNT(*) AS n
               FROM lote GROUP BY fk_produto, fk_armazem) ls
           ON ls.fk_produto = s.cod_produto_codigo AND ls.fk_armazem = s.cod_armazem
    WHERE ($P{ARMAZEM_ID} = 0 OR s.cod_armazem = $P{ARMAZEM_ID})
      AND ($P{PRODUTO_ID} = 0 OR s.cod_produto_codigo = $P{PRODUTO_ID})
      AND (ls.n IS NULL OR ABS((s.quantidade_existente - COALESCE(ls.soma, 0))) > 0.0001)

) x
WHERE ($P{SITUACAO} = 'TODAS' OR x.situacao = $P{SITUACAO})
  AND ($P{INCLUIR_ZERO} = 1 OR ABS(x.qtd_sistema) > 0.0001)
ORDER BY x.armazem, x.armazem_id, x.produto, x.produto_id, (x.validade_ord IS NULL), x.validade_ord, x.numero_lote
		]]>
	</queryString>

	<field name="armazem_id" class="java.lang.Integer"/>
	<field name="armazem" class="java.lang.String"/>
	<field name="produto_id" class="java.lang.Integer"/>
	<field name="produto" class="java.lang.String"/>
	<field name="numero_lote" class="java.lang.String"/>
	<field name="validade_txt" class="java.lang.String"/>
	<field name="dias" class="java.lang.Integer"/>
	<field name="situacao" class="java.lang.String"/>
	<field name="qtd_sistema" class="java.math.BigDecimal"/>
	<field name="preco" class="java.math.BigDecimal"/>
	<field name="valor" class="java.math.BigDecimal"/>

	<variable name="QTD_ARM" class="java.math.BigDecimal" resetType="Group" resetGroup="armazem" calculation="Sum">
		<variableExpression><![CDATA[$F{qtd_sistema}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="QTD_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{qtd_sistema}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="PROD_ARM" class="java.lang.Integer" resetType="Group" resetGroup="armazem" calculation="DistinctCount">
		<variableExpression><![CDATA[$F{produto_id}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.lang.Integer(0)]]></initialValueExpression>
	</variable>
	<variable name="PROD_TOTAL" class="java.lang.Integer" calculation="DistinctCount">
		<variableExpression><![CDATA[$F{produto_id}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.lang.Integer(0)]]></initialValueExpression>
	</variable>
	<variable name="VAL_ARM" class="java.math.BigDecimal" resetType="Group" resetGroup="armazem" calculation="Sum">
		<variableExpression><![CDATA[$F{valor}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="VAL_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{valor}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>

	<group name="armazem" isStartNewPage="true" isReprintHeaderOnEachPage="true">
		<groupExpression><![CDATA[$F{armazem_id}]]></groupExpression>
		<groupHeader>
			<band height="22">
				<rectangle>
					<reportElement x="0" y="2" width="802" height="19" backcolor="#1F3A5F"/>
					<graphicElement><pen lineWidth="0.0"/></graphicElement>
				</rectangle>
				<textField>
					<reportElement x="6" y="2" width="790" height="19" forecolor="#FFFFFF"/>
