	<summary>
		<band height="84">
			<line><reportElement x="0" y="2" width="802" height="2"/></line>
			<textField isBlankWhenNull="true"><reportElement x="0" y="8" width="406" height="18"></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["TOTAL GERAL  (" + $V{PROD_TOTAL} + " produto(s))"]]></textFieldExpression></textField>
			<textField pattern="#,##0.###;-#,##0.###" isBlankWhenNull="true"><reportElement x="410" y="8" width="52" height="18"></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{QTD_TOTAL}]]></textFieldExpression></textField>
			<textField pattern="#,##0.00" isBlankWhenNull="true"><reportElement x="530" y="8" width="77" height="18" forecolor="#006400"></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{VAL_TOTAL}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="0" y="32" width="802" height="14" forecolor="#555555"></reportElement><textElement textAlignment="Left" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA["Legenda: Vencido = validade ultrapassada  |  A vencer = caduca nos pr\u00f3ximos " + $P{DIAS_ALERTA} + " dias  |  Sem lote = stock sem lote registado  |  Divergente = lotes superiores ao stock do sistema"]]></textFieldExpression></textField>
