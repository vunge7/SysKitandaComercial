				<textFieldExpression><![CDATA["Armaz\u00e9m: " + $P{ARMAZEM_NOME} + "      Produto: " + $P{PRODUTO_NOME}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="54" width="802" height="16"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="10"/></textElement>
				<textFieldExpression><![CDATA["Situa\u00e7\u00e3o: " + $P{SITUACAO_NOME} + "      Alerta de validade: " + $P{DIAS_ALERTA} + " dias      Incluir stock zero: " + ($P{INCLUIR_ZERO}.intValue() == 1 ? "Sim" : "N\u00e3o")]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="70" width="802" height="16"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="10"/></textElement>
				<textFieldExpression><![CDATA["Data do invent\u00e1rio: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
			</textField>
		</band>
	</title>

