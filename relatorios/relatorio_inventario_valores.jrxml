			<rectangle><reportElement mode="Transparent" stretchType="RelativeToBandHeight" x="670" y="0" width="55" height="18"/><graphicElement><pen lineWidth="0.5" lineColor="#808080"/></graphicElement></rectangle>
			<rectangle><reportElement mode="Transparent" stretchType="RelativeToBandHeight" x="725" y="0" width="77" height="18"/><graphicElement><pen lineWidth="0.5" lineColor="#808080"/></graphicElement></rectangle>
			<line><reportElement positionType="FixRelativeToBottom" x="0" y="17" width="802" height="1" forecolor="#C8C8C8"/></line>
		</band>
	</detail>

