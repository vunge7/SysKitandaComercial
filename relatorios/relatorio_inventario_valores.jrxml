			<staticText><reportElement x="611" y="0" width="58" height="26" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Qtd. Contada]]></text></staticText>
			<staticText><reportElement x="671" y="0" width="53" height="26" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Diferença]]></text></staticText>
