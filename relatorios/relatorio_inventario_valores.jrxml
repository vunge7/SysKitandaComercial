	<detail>
		<band height="18">
			<rectangle><reportElement mode="Opaque" stretchType="RelativeToBandHeight" x="0" y="0" width="802" height="18" backcolor="#F2F2F2"><printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression></reportElement><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
			<textField isBlankWhenNull="true"><reportElement x="1" y="0" width="38" height="18" stretchType="RelativeToTallestObject" isPrintRepeatedValues="false" isPrintInFirstWholeBand="true"></reportElement><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{produto_id}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true" isStretchWithOverflow="true"><reportElement x="41" y="0" width="148" height="18" isPrintRepeatedValues="false" isPrintInFirstWholeBand="true"></reportElement><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{produto}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="191" y="0" width="68" height="18" stretchType="RelativeToTallestObject"></reportElement><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[($F{numero_lote} == null || $F{numero_lote}.trim().isEmpty()) ? "-" : $F{numero_lote}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="261" y="0" width="53" height="18" stretchType="RelativeToTallestObject"></reportElement><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{validade_txt} == null ? "-" : $F{validade_txt}]]></textFieldExpression></textField>
			<textField pattern="#,##0;-#,##0" isBlankWhenNull="true"><reportElement x="315" y="0" width="32" height="18" forecolor="#D00000" stretchType="RelativeToTallestObject"><printWhenExpression><![CDATA[$F{dias} != null && $F{dias}.intValue() < 0]]></printWhenExpression></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{dias}]]></textFieldExpression></textField>
			<textField pattern="#,##0;-#,##0" isBlankWhenNull="true"><reportElement x="315" y="0" width="32" height="18" stretchType="RelativeToTallestObject"><printWhenExpression><![CDATA[$F{dias} == null || $F{dias}.intValue() >= 0]]></printWhenExpression></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{dias}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="351" y="0" width="58" height="18" forecolor="#D00000" stretchType="RelativeToTallestObject"><printWhenExpression><![CDATA[$F{situacao}.equals("VENCIDO") || $F{situacao}.equals("DIVERGENTE")]]></printWhenExpression></reportElement><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{situacao}.equals("VENCIDO") ? "Vencido" : $F{situacao}.equals("A_VENCER") ? "A vencer" : $F{situacao}.equals("OK") ? "V\u00e1lido" : $F{situacao}.equals("SEM_LOTE") ? "Sem lote" : $F{situacao}.equals("DIVERGENTE") ? "Divergente" : "S/ validade"]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="351" y="0" width="58" height="18" forecolor="#E07B00" stretchType="RelativeToTallestObject"><printWhenExpression><![CDATA[$F{situacao}.equals("A_VENCER")]]></printWhenExpression></reportElement><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{situacao}.equals("VENCIDO") ? "Vencido" : $F{situacao}.equals("A_VENCER") ? "A vencer" : $F{situacao}.equals("OK") ? "V\u00e1lido" : $F{situacao}.equals("SEM_LOTE") ? "Sem lote" : $F{situacao}.equals("DIVERGENTE") ? "Divergente" : "S/ validade"]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="351" y="0" width="58" height="18" forecolor="#006400" stretchType="RelativeToTallestObject"><printWhenExpression><![CDATA[$F{situacao}.equals("OK")]]></printWhenExpression></reportElement><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{situacao}.equals("VENCIDO") ? "Vencido" : $F{situacao}.equals("A_VENCER") ? "A vencer" : $F{situacao}.equals("OK") ? "V\u00e1lido" : $F{situacao}.equals("SEM_LOTE") ? "Sem lote" : $F{situacao}.equals("DIVERGENTE") ? "Divergente" : "S/ validade"]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="351" y="0" width="58" height="18" forecolor="#555555" stretchType="RelativeToTallestObject"><printWhenExpression><![CDATA[!($F{situacao}.equals("VENCIDO") || $F{situacao}.equals("DIVERGENTE") || $F{situacao}.equals("A_VENCER") || $F{situacao}.equals("OK"))]]></printWhenExpression></reportElement><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{situacao}.equals("VENCIDO") ? "Vencido" : $F{situacao}.equals("A_VENCER") ? "A vencer" : $F{situacao}.equals("OK") ? "V\u00e1lido" : $F{situacao}.equals("SEM_LOTE") ? "Sem lote" : $F{situacao}.equals("DIVERGENTE") ? "Divergente" : "S/ validade"]]></textFieldExpression></textField>
			<textField pattern="#,##0.###;-#,##0.###" isBlankWhenNull="true"><reportElement x="410" y="0" width="52" height="18" stretchType="RelativeToTallestObject"></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{qtd_sistema}]]></textFieldExpression></textField>
