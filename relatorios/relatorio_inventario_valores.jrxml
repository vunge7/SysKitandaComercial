					<textFieldExpression><![CDATA["ARMAZ\u00c9M: " + $F{armazem}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="28">
			<line><reportElement x="0" y="0" width="802" height="1"/></line>
			<textField isBlankWhenNull="true"><reportElement x="0" y="4" width="406" height="18"></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["TOTAL DO ARMAZ\u00c9M  (" + $V{PROD_ARM} + " produto(s))"]]></textFieldExpression></textField>
			<textField pattern="#,##0.###;-#,##0.###" isBlankWhenNull="true"><reportElement x="410" y="4" width="52" height="18"></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{QTD_ARM}]]></textFieldExpression></textField>
			<textField pattern="#,##0.00" isBlankWhenNull="true"><reportElement x="530" y="4" width="77" height="18" forecolor="#006400"></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{VAL_ARM}]]></textFieldExpression></textField>
			</band>
		</groupFooter>
	</group>

	<title>
		<band height="92">
			<staticText>
				<reportElement x="0" y="4" width="802" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="20" isBold="true"/></textElement>
				<text><![CDATA[INVENTÁRIO]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="38" width="802" height="16"/>
