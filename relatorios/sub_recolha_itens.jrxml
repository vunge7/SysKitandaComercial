<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="sub_recolha_itens" pageWidth="188" pageHeight="400" columnWidth="188" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="e1980b50-bca8-40dd-a53d-e582335ea911">
<parameter name="CODIGO_VENDA" class="java.lang.Integer"/>
<queryString><![CDATA[SELECT
     tb_item_venda.`quantidade` AS qtd,
     tb_produto.`designacao` AS peca,
     tb_item_venda.`obs` AS obs,
     tb_preco.`preco_venda` AS preco,
     tb_item_venda.`data_entrega` AS data_entrega
FROM `tb_item_venda` tb_item_venda
     INNER JOIN `tb_produto` tb_produto ON tb_produto.`codigo` = tb_item_venda.`codigo_produto`
     INNER JOIN `tb_preco` tb_preco ON tb_item_venda.`fk_preco` = tb_preco.`pk_preco`
WHERE tb_item_venda.`codigo_venda` = $P{CODIGO_VENDA}
ORDER BY tb_item_venda.`posicao`, tb_item_venda.`codigo`]]></queryString>
<field name="qtd" class="java.lang.Double"/>
<field name="peca" class="java.lang.String"/>
<field name="obs" class="java.lang.String"/>
<field name="preco" class="java.math.BigDecimal"/>
<field name="data_entrega" class="java.sql.Timestamp"/>
<variable name="PECAS" class="java.lang.Double" calculation="Sum"><variableExpression><![CDATA[$F{qtd}]]></variableExpression></variable>
<background><band splitType="Stretch"/></background><columnHeader><band height="14" splitType="Stretch"><staticText><reportElement x="0" y="0" width="20" height="12" uuid="ac4a27a0-6215-47a4-8849-a4f521235f37"></reportElement><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true" isItalic="false"/></textElement><text><![CDATA[Qtd]]></text></staticText><staticText><reportElement x="20" y="0" width="112" height="12" uuid="f2c1f110-23e9-47ac-ba2b-ee8992b6b254"></reportElement><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true" isItalic="false"/></textElement><text><![CDATA[Peça / Observação]]></text></staticText><staticText><reportElement x="132" y="0" width="56" height="12" uuid="4658d414-4f59-4567-a96c-e4c00ec13427"></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true" isItalic="false"/></textElement><text><![CDATA[Valor (AOA)]]></text></staticText><line><reportElement x="0" y="12" width="188" height="1" uuid="726cee8a-fc66-437b-8d48-4cb2162c004f"></reportElement><graphicElement><pen lineWidth="1.0" lineStyle="Solid"/></graphicElement></line></band></columnHeader><detail><band height="26" splitType="Stretch"><textField isBlankWhenNull="true" pattern="#,##0.##"><reportElement x="0" y="2" width="20" height="12" uuid="3cf73971-c065-42ac-9cbc-56170b4267c6"></reportElement><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true" isItalic="false"/></textElement><textFieldExpression><![CDATA[$F{qtd}]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="20" y="2" width="112" height="12" uuid="6a075151-302f-4c8a-9a7c-b62b0eb3fcd5"></reportElement><box bottomPadding="1"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true" isItalic="false"/></textElement><textFieldExpression><![CDATA[$F{peca}]]></textFieldExpression></textField><textField isBlankWhenNull="true" pattern="#,##0.00"><reportElement x="132" y="2" width="56" height="12" uuid="5f5e16e4-a2e7-4175-8e1c-5f9d0ae3c233"></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true" isItalic="false"/></textElement><textFieldExpression><![CDATA[$F{preco}.doubleValue() * $F{qtd}]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" isRemoveLineWhenBlank="true" forecolor="#555555" x="20" y="14" width="112" height="10" uuid="cd784046-10fd-43fb-8766-c2b8f99e9ea4"><printWhenExpression><![CDATA[!($F{obs} == null || $F{obs}.toString().trim().isEmpty())]]></printWhenExpression></reportElement><box bottomPadding="1"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="false" isItalic="true"/></textElement><textFieldExpression><![CDATA[$F{obs}]]></textFieldExpression></textField><line><reportElement positionType="Float" x="0" y="25" width="188" height="1" uuid="ce4de99b-266d-4a3c-9e96-1f8974a8bffe"></reportElement><graphicElement><pen lineWidth="0.5" lineStyle="Dashed"/></graphicElement></line></band></detail><summary><band height="16" splitType="Stretch"><textField isBlankWhenNull="true"><reportElement x="0" y="2" width="188" height="12" uuid="4066d400-3da3-490b-893e-f7fe6ea9e492"></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true" isItalic="false"/></textElement><textFieldExpression><![CDATA["Total de peças: " + new java.text.DecimalFormat("#,##0.##").format($V{PECAS})]]></textFieldExpression></textField></band></summary></jasperReport>
