<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="lista_reservas" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="bb3fa42d-3fc3-4f21-becc-b37d51c6d636">
	<property name="ireport.zoom" value="3.2210200000000113"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Kitanda_Connection"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<style name="style3">
		<paragraph lineSpacing="Single"/>
	</style>
	<parameter name="ano" class="java.lang.Integer"/>
	<parameter name="mes" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select  f.designacao , sum(i.valor_real) as total  from forma_pagamento_item i
inner join tb_venda v on v.codigo = i.fk_venda
inner join forma_pagamento f on f.pk_forma_pagamento = i.fk_forma_pagamento
where year(v.dataVenda) =  $P{ano} and month(v.dataVenda) =  $P{mes}
and v.status_eliminado = 'false'
and v.fk_documento = 1
group by i.fk_forma_pagamento;]]>
	</queryString>
	<field name="designacao" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="total" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="total"/>
		<property name="com.jaspersoft.studio.field.label" value="total"/>
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<variable name="TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
