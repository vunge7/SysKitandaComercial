<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="relatorio_controlo_movimentacao_stock_valores" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="2b844019-3775-4919-8835-b548094cf36d">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="EstiloVendaLinha" forecolor="#006400">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{valor_venda} != null && $F{valor_venda}.signum() < 0]]></conditionExpression>
			<style forecolor="#D00000"/>
		</conditionalStyle>
	</style>
	<style name="EstiloVendaProd" forecolor="#006400">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{VEND_PROD}.signum() < 0]]></conditionExpression>
			<style forecolor="#D00000"/>
		</conditionalStyle>
	</style>
	<style name="EstiloVendaTotal" forecolor="#006400">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{VEND_TOTAL}.signum() < 0]]></conditionExpression>
			<style forecolor="#D00000"/>
		</conditionalStyle>
	</style>
	<parameter name="DATA_INICIO" class="java.util.Date"/>
	<parameter name="DATA_FIM" class="java.util.Date"/>
	<parameter name="ARMAZEM_ID" class="java.lang.Integer"/>
	<parameter name="ARMAZEM_NOME" class="java.lang.String"/>
	<parameter name="PRODUTO_ID" class="java.lang.Integer"/>
	<parameter name="PRODUTO_NOME" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT x.* FROM (

    /* A) PRODUTOS COM LOTES: movimento por lote */
    SELECT
        m.id,
        m.data_mov,
        m.tipo AS tipo_cod,
        CASE
            WHEN m.tipo = 'COMPRA' THEN COALESCE(c.cod_fact, CAST(m.fk_operacao AS CHAR))
            WHEN m.tipo = 'DEVOLUCAO' THEN
                 CASE WHEN nc.cod_fact IS NOT NULL
                      THEN CONCAT(nc.cod_fact, CASE WHEN COALESCE(NULLIF(nc.ref_cod_fact,''), CASE WHEN v.fk_documento <> 5 THEN v.cod_fact END) IS NOT NULL
                                    THEN CONCAT(' (', COALESCE(NULLIF(nc.ref_cod_fact,''), v.cod_fact), ')') ELSE '' END)  /* ex: NC 2026/4 (FR 2026/6) */
                      ELSE COALESCE(v.cod_fact, CAST(m.fk_operacao AS CHAR)) END
            WHEN m.tipo = 'VENDA' THEN COALESCE(v.cod_fact, CAST(m.fk_operacao AS CHAR))
            ELSE CAST(m.fk_operacao AS CHAR)
        END AS doc_ref,
        a.designacao AS armazem,
        l.numero_lote AS numero_lote,
        DATE_FORMAT(l.data_validade, '%d/%m/%Y') AS validade_txt,
        p.codigo AS produto_id,
        p.designacao AS produto,
        CASE WHEN m.tipo IN ('COMPRA','TRANSF_ENTRADA','DEVOLUCAO') THEN m.qtd ELSE 0 END AS entrada,
        CASE WHEN m.tipo IN ('VENDA','TRANSF_SAIDA')               THEN m.qtd ELSE 0 END AS saida,
        /* total da compra: so na 1.a linha (lote) do produto nessa compra, para nao repetir */
        CAST(CASE WHEN m.tipo = 'COMPRA' AND m.id = (
                    SELECT MIN(m2.id) FROM lote_movimento m2
                    INNER JOIN lote l2 ON l2.id = m2.fk_lote
                    WHERE m2.tipo = m.tipo AND m2.fk_operacao = m.fk_operacao AND l2.fk_produto = l.fk_produto)
                  THEN c.total_compra ELSE 0 END AS DECIMAL(18,2)) AS valor_compra,
        /* total da factura de venda: idem */
        CAST(CASE WHEN m.tipo = 'VENDA' AND m.id = (
                    SELECT MIN(m3.id) FROM lote_movimento m3
                    INNER JOIN lote l3 ON l3.id = m3.fk_lote
                    WHERE m3.tipo = m.tipo AND m3.fk_operacao = m.fk_operacao AND l3.fk_produto = l.fk_produto)
                  THEN v.total_venda
                  /* nota de credito: valor NEGATIVO em Vendas (so na 1.a linha do produto nessa NC) */
                  WHEN m.tipo = 'DEVOLUCAO' AND nc.codigo IS NOT NULL AND m.id = (
                    SELECT MIN(m4.id) FROM lote_movimento m4
                    INNER JOIN lote l4 ON l4.id = m4.fk_lote
                    WHERE m4.tipo = m.tipo AND m4.fk_operacao = m.fk_operacao AND l4.fk_produto = l.fk_produto
                      AND m4.data_mov BETWEEN DATE_SUB(nc.dataVenda, INTERVAL 2 MINUTE) AND DATE_ADD(nc.dataVenda, INTERVAL 2 MINUTE))
                  THEN -nc.total_venda
                  ELSE 0 END AS DECIMAL(18,2)) AS valor_venda,
        /* mesmo valor da NC, POSITIVO, na coluna Anulacao */
        CAST(CASE WHEN m.tipo = 'DEVOLUCAO' AND nc.codigo IS NOT NULL AND m.id = (
                    SELECT MIN(m4.id) FROM lote_movimento m4
                    INNER JOIN lote l4 ON l4.id = m4.fk_lote
                    WHERE m4.tipo = m.tipo AND m4.fk_operacao = m.fk_operacao AND l4.fk_produto = l.fk_produto
                      AND m4.data_mov BETWEEN DATE_SUB(nc.dataVenda, INTERVAL 2 MINUTE) AND DATE_ADD(nc.dataVenda, INTERVAL 2 MINUTE))
                  THEN nc.total_venda ELSE 0 END AS DECIMAL(18,2)) AS valor_anulacao,
        COALESCE(t.nome_usuario, u.nome) AS utilizador
    FROM lote_movimento m
    INNER JOIN lote l        ON l.id = m.fk_lote
    INNER JOIN tb_produto p  ON p.codigo = l.fk_produto
    INNER JOIN tb_armazem a  ON a.codigo = l.fk_armazem
    LEFT JOIN tb_venda v     ON m.tipo IN ('VENDA','DEVOLUCAO') AND v.codigo = m.fk_operacao
    /* nota de credito (documento 5) que anula a fatura da devolucao: liga por ref_cod_fact (exato).
       Se houver varias NC da mesma fatura, escolhe a mais proxima do movimento.
       NC antigas sem ref_cod_fact: usa a NC emitida no mesmo momento (+-2 min) */
    LEFT JOIN tb_venda nc    ON m.tipo = 'DEVOLUCAO' AND nc.codigo = COALESCE(
                                    (SELECT n.codigo FROM tb_venda n
                                     WHERE n.fk_documento = 5 AND n.ref_cod_fact = v.cod_fact
                                     ORDER BY ABS(TIMESTAMPDIFF(SECOND, n.dataVenda, m.data_mov)), n.codigo
                                     LIMIT 1),
                                    (SELECT n3.codigo FROM tb_venda n3
                                     WHERE n3.fk_documento = 5 AND (n3.ref_cod_fact IS NULL OR n3.ref_cod_fact = '')
                                       AND n3.dataVenda BETWEEN DATE_SUB(m.data_mov, INTERVAL 2 MINUTE)
                                                            AND DATE_ADD(m.data_mov, INTERVAL 2 MINUTE)
                                     ORDER BY ABS(TIMESTAMPDIFF(SECOND, n3.dataVenda, m.data_mov)), n3.codigo
                                     LIMIT 1))
    LEFT JOIN compras c      ON m.tipo = 'COMPRA' AND c.pk_compra = m.fk_operacao
    LEFT JOIN transferencia_armazem t
                             ON m.tipo IN ('TRANSF_SAIDA','TRANSF_ENTRADA') AND t.pk_transferencia_armazem = m.fk_operacao
    LEFT JOIN tb_usuario u   ON u.codigo = COALESCE(v.codigo_usuario, c.codigo_usuario, t.fk_usuario)
    WHERE m.data_mov >= $P{DATA_INICIO}
      AND m.data_mov <  DATE_ADD($P{DATA_FIM}, INTERVAL 1 DAY)
      AND ($P{ARMAZEM_ID} = 0 OR l.fk_armazem = $P{ARMAZEM_ID})
      AND ($P{PRODUTO_ID} = 0 OR p.codigo = $P{PRODUTO_ID})

    UNION ALL

    /* B) MOVIMENTOS SEM LOTE (produtos sem lotes, movimentos antigos ou sem registo de lote): lote e validade = '-' */
    SELECT
        mv.id,
        mv.data_mov,
        CASE WHEN nc2.codigo IS NOT NULL THEN 'DEVOLUCAO' ELSE mv.tipo END AS tipo_cod,   /* documento NC => Devolucao */
        CASE WHEN nc2.codigo IS NOT NULL
             THEN CONCAT(nc2.cod_fact, CASE WHEN nc2.ref_cod_fact IS NOT NULL AND nc2.ref_cod_fact <> '' THEN CONCAT(' (', nc2.ref_cod_fact, ')') ELSE '' END)  /* ex: NC 2026/3 (FR 2026/10) */
             ELSE mv.documento END AS doc_ref,
        a2.designacao AS armazem,
        '-' AS numero_lote,
        '-' AS validade_txt,
        p2.codigo AS produto_id,
        p2.designacao AS produto,
        CASE mv.tipo
            WHEN 'ENTRADA' THEN mv.quantidade
            WHEN 'SAIDA'   THEN 0
            ELSE GREATEST(mv.quantidade_actual - mv.quantidade_anterior, 0)
        END AS entrada,
        CASE mv.tipo
            WHEN 'ENTRADA' THEN 0
            WHEN 'SAIDA'   THEN mv.quantidade
            ELSE GREATEST(mv.quantidade_anterior - mv.quantidade_actual, 0)
        END AS saida,
        /* sem lote nao ha ligacao por id: liga-se pelo numero do documento (documento = cod_fact) */
        CAST(CASE WHEN mv.tipo = 'ENTRADA'
                  THEN COALESCE((SELECT c2.total_compra FROM compras c2 WHERE c2.cod_fact = mv.documento LIMIT 1), 0)
                  ELSE 0 END AS DECIMAL(18,2)) AS valor_compra,
        CAST(CASE WHEN mv.tipo = 'SAIDA'
                  THEN COALESCE((SELECT v2.total_venda FROM tb_venda v2 WHERE v2.cod_fact = mv.documento LIMIT 1), 0)
                  WHEN nc2.codigo IS NOT NULL THEN -nc2.total_venda
                  ELSE 0 END AS DECIMAL(18,2)) AS valor_venda,
        CAST(CASE WHEN nc2.codigo IS NOT NULL THEN nc2.total_venda ELSE 0 END AS DECIMAL(18,2)) AS valor_anulacao,
        u2.nome AS utilizador
    FROM movimentacao mv
    INNER JOIN tb_produto p2 ON p2.codigo = mv.produto_id
    INNER JOIN tb_armazem a2 ON a2.codigo = mv.armazem_id
    /* NC sem lote: reconhece-se pelo numero do documento (documento tipo 5 = Nota de credito);
       se for um movimento 'DEVOLUCAO' sem numero de NC, usa a NC emitida no mesmo momento (+-2 min) */
    LEFT JOIN tb_venda nc2   ON nc2.codigo = COALESCE(
                                    (SELECT n1.codigo FROM tb_venda n1 WHERE n1.cod_fact = mv.documento AND n1.fk_documento = 5 LIMIT 1),
                                    CASE WHEN mv.tipo = 'DEVOLUCAO' THEN
                                    (SELECT n2.codigo FROM tb_venda n2
                                     WHERE n2.fk_documento = 5
                                       AND n2.dataVenda BETWEEN DATE_SUB(mv.data_mov, INTERVAL 2 MINUTE)
                                                            AND DATE_ADD(mv.data_mov, INTERVAL 2 MINUTE)
                                     ORDER BY ABS(TIMESTAMPDIFF(SECOND, n2.dataVenda, mv.data_mov)), n2.codigo
                                     LIMIT 1) END)
    LEFT JOIN tb_usuario u2  ON u2.codigo = mv.usuario_id
    WHERE mv.data_mov >= $P{DATA_INICIO}
      AND mv.data_mov <  DATE_ADD($P{DATA_FIM}, INTERVAL 1 DAY)
      AND ($P{ARMAZEM_ID} = 0 OR mv.armazem_id = $P{ARMAZEM_ID})
      AND ($P{PRODUTO_ID} = 0 OR p2.codigo = $P{PRODUTO_ID})
      /* so entra se NAO foi ja detalhado por lote (mesmo produto + armazem + mesma hora, margem de 2 min) */
      AND NOT EXISTS (
            SELECT 1
            FROM lote_movimento lm
            INNER JOIN lote lx ON lx.id = lm.fk_lote
            WHERE lx.fk_produto = mv.produto_id
              AND lx.fk_armazem = mv.armazem_id
              AND lm.data_mov BETWEEN DATE_SUB(mv.data_mov, INTERVAL 2 MINUTE)
                                  AND DATE_ADD(mv.data_mov, INTERVAL 2 MINUTE)
      )

) x
ORDER BY x.produto, x.produto_id, x.data_mov, x.id]]>
	</queryString>
	<field name="id" class="java.lang.Integer"/>
	<field name="data_mov" class="java.sql.Timestamp"/>
	<field name="tipo_cod" class="java.lang.String"/>
	<field name="doc_ref" class="java.lang.String"/>
	<field name="armazem" class="java.lang.String"/>
	<field name="numero_lote" class="java.lang.String"/>
	<field name="validade_txt" class="java.lang.String"/>
	<field name="produto_id" class="java.lang.Integer"/>
	<field name="produto" class="java.lang.String"/>
	<field name="entrada" class="java.lang.Double"/>
	<field name="saida" class="java.lang.Double"/>
	<field name="valor_compra" class="java.math.BigDecimal"/>
	<field name="valor_venda" class="java.math.BigDecimal"/>
	<field name="valor_anulacao" class="java.math.BigDecimal"/>
	<field name="utilizador" class="java.lang.String"/>
	<variable name="ENT_PROD" class="java.lang.Double" resetType="Group" resetGroup="produto" calculation="Sum">
		<variableExpression><![CDATA[$F{entrada}]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
	</variable>
	<variable name="SAI_PROD" class="java.lang.Double" resetType="Group" resetGroup="produto" calculation="Sum">
		<variableExpression><![CDATA[$F{saida}]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
	</variable>
	<variable name="COMP_PROD" class="java.math.BigDecimal" resetType="Group" resetGroup="produto" calculation="Sum">
		<variableExpression><![CDATA[$F{valor_compra}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="VEND_PROD" class="java.math.BigDecimal" resetType="Group" resetGroup="produto" calculation="Sum">
		<variableExpression><![CDATA[$F{valor_venda}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="ANUL_PROD" class="java.math.BigDecimal" resetType="Group" resetGroup="produto" calculation="Sum">
		<variableExpression><![CDATA[$F{valor_anulacao}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="ENT_TOTAL" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{entrada}]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
	</variable>
	<variable name="SAI_TOTAL" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{saida}]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
	</variable>
	<variable name="COMP_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{valor_compra}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="VEND_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{valor_venda}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="ANUL_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{valor_anulacao}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<group name="produto">
		<groupExpression><![CDATA[$F{produto_id}]]></groupExpression>
