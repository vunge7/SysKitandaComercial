	<title>
		<band height="72">
			<staticText>
				<reportElement uuid="b72ded26-56e7-48ae-bdad-6fa6f45529d7" x="0" y="4" width="802" height="26"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="16" isBold="true"/>
				</textElement>
				<text><![CDATA[RELATÓRIO DE CONTROLO DE VALORES E DE MOVIMENTAÇÃO DO STOCK]]></text>
			</staticText>
			<textField>
				<reportElement uuid="25c5952d-cf42-45b3-aa1d-96fdfa6bc05c" x="0" y="34" width="802" height="16"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["Per\u00edodo: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{DATA_INICIO}) + "  a  " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{DATA_FIM})]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="51190a45-0812-4a3a-99b9-b7f5cc51c552" x="0" y="50" width="802" height="16"/>
