<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="relatorio_vendas_mes_final" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="26339fb4-c0cd-49bc-920a-537ec019b645">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="MES_PARAM" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT  
    v.dataVenda,
    v.nome_cliente,
    u.username AS nome_usuario,
    p.designacao AS nome_produto,
    iv.total,
    
    di.nome AS empresa_nome,
    di.nif AS empresa_nif,
    di.telefone AS empresa_telefone,
    di.enderecos AS empresa_enderecos

FROM 
    tb_venda v
    INNER JOIN tb_item_venda iv ON iv.codigo_venda = v.codigo
    INNER JOIN tb_usuario u ON u.codigo = v.codigo_usuario
    INNER JOIN tb_produto p ON p.codigo = iv.codigo_produto
    CROSS JOIN tb_dados_instituicao di  -- Traz sempre o único registo da instituição

WHERE 
    TRIM(SUBSTRING_INDEX(iv.designacao_item, '#', -1)) 
        LIKE CONCAT('%', $P{MES_PARAM}, '%')

ORDER BY 
    v.dataVenda ASC;
]]>
	</queryString>
	<field name="dataVenda" class="java.sql.Timestamp">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nome_cliente" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nome_usuario" class="java.lang.String"/>
	<field name="nome_produto" class="java.lang.String"/>
	<field name="total" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="empresa_nome" class="java.lang.String"/>
	<field name="empresa_nif" class="java.lang.String"/>
	<field name="empresa_telefone" class="java.lang.String"/>
	<field name="empresa_enderecos" class="java.lang.String"/>
