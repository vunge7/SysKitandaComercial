	<style name="cliente_style" mode="Transparent" forecolor="#000000">
		<conditionalStyle>
			<conditionExpression><![CDATA[$P{NIF_CLIENTE_CONSOMIDOR_FINAL}.equals("Consumidor Final")]]></conditionExpression>
