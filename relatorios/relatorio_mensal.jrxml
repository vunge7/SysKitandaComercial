	<queryString>
		<![CDATA[select r.*,  di.nome  , di.nif, di.enderecos , di.telefone , di.email
from  relatorio_mensal r
inner join tb_dados_instituicao di
where  year(data_relatorio) = $P{ano} and month(data_relatorio) = $P{mes}]]>
	</queryString>
