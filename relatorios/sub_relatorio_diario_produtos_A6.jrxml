<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="relatorio_diario_produtos" language="groovy" pageWidth="200" pageHeight="842" columnWidth="190" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" uuid="963621be-cfd4-4f53-8a8b-bed5b630fd64">
	<property name="ireport.zoom" value="6.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARM_DATA_2" class="java.sql.Timestamp"/>
	<parameter name="PARM_DATA_1" class="java.sql.Timestamp"/>
	<parameter name="PARM_ID_ARMAZEM" class="java.lang.Integer"/>
	<parameter name="PARM_ID_USUARIO" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
     SUM(item.quantidade) AS QTD,
     produto.`codigo`,
     produto.`designacao`,
     tb_preco.`preco_venda` AS tb_preco_preco_venda,
     SUM(item.total)  AS total
FROM
     `tb_item_venda` item INNER JOIN `tb_venda` venda ON item.`codigo_venda` = venda.`codigo`
     INNER JOIN `tb_produto` produto ON item.`codigo_produto` = produto.`codigo`
     INNER JOIN `tb_preco` tb_preco ON item.`fk_preco` = tb_preco.`pk_preco`
WHERE item.codigo_venda = venda.codigo AND item.codigo_produto = produto.codigo
      AND venda.dataVenda BETWEEN $P{PARM_DATA_1} AND $P{PARM_DATA_2}
 AND venda.`idArmazemFK` = $P{PARM_ID_ARMAZEM} AND venda.fk_documento IN(1,2)
 AND venda.`status_eliminado` = 'false'
AND venda.codigo_usuario = $P{PARM_ID_USUARIO}
GROUP BY produto.codigo, produto.designacao, tb_preco.preco_venda
ORDER BY produto.designacao;]]>
	</queryString>
	<field name="QTD" class="java.lang.Double">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="codigo" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="designacao" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="tb_preco_preco_venda" class="java.math.BigDecimal"/>
	<field name="total" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<variable name="TOTAL" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{QTD}]]></variableExpression>
	</variable>
	<variable name="TOTAL__VALOR_TOTAL" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
